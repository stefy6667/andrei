APP_NAME=voice-agent
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://your-domain.com

# Business customization
BUSINESS_NAME=Demo Retail
BUSINESS_DOMAIN=ecommerce support
AGENT_NAME=Andrei
GREETING_RO=Bună! Sunt {agent_name} de la {business_name}. Cu ce te pot ajuta astăzi?
GREETING_EN=Hello! I'm {agent_name} from {business_name}. How can I help you today?
INTRO_ONLY_MODE=false

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SMS_FROM_NUMBER=
TWILIO_VOICE_EN=Polly.Amy-Neural
TWILIO_VOICE_RO=Google.ro-RO-Wavenet-B
TWILIO_RECORD_CALLS=false
TWILIO_RECORDING_STATUS_CALLBACK=
TWILIO_DEFAULT_LANGUAGE=ro-RO
TTS_PROVIDER_RO=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_RO=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Behavior style
BEHAVIOR_STYLE_EN=Warm, friendly, concise, and natural. Use short sentences and empathy.
BEHAVIOR_STYLE_RO=Cald, prietenos, concis și natural. Folosește propoziții scurte și empatie.

# Integrations
DATABASE_URL=sqlite:///./voice_agent.db
CRM_API_BASE_URL=
CRM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Bucharest
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
HUMAN_HANDOFF_NUMBER=
ADMIN_ALERT_EMAIL=

# Web research
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=3
WEBSITE_CONTEXT_URL=
WEBSITE_CONTEXT_MODE=faq_only
EVENTS_SOURCE_URL=https://www.iabilet.ro/
EVENTS_MAX_RESULTS=5
EVENTS_CONTEXT_MODE=always
